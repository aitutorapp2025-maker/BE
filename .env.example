# ── App ────────────────────────────────────────────────────────────────────
APP_NAME=Vaha AI Backend
APP_ENV=development          # development | production
APP_PORT=8080
# In development the student OTP is this fixed code and NO SMS is sent, so login
# can be tested offline. In production (APP_ENV=production) a real random code is
# generated and delivered by the SMS gateway instead.
OTP_STATIC=202627

# ── PostgreSQL (GORM) ──────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vaha_ai
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Kolkata

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── RabbitMQ ───────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# ── Auth (JWT) ─────────────────────────────────────────────────────────────
JWT_SECRET=dev-insecure-change-me-in-production
JWT_TTL_HOURS=24

# ── Email (SMTP) ───────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to DISABLE sending (contact submissions are still saved).
# For Gmail: host smtp.gmail.com, port 587, user = your address, password = an
# App Password. For local testing use MailHog (host 127.0.0.1, port 1025, no auth).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@vahaai.com
SMTP_FROM_NAME=Vaha AI

# ── AI tutor (RAG) ───────────────────────────────────────────────────────
# Keys are normally set in the ADMIN PANEL (Settings → AI Tutor), which wins
# over these env vars. These are only a fallback / bootstrap. The pipeline also
# needs pgvector installed on the PostgreSQL server (CREATE EXTENSION vector).
# The app runs normally without any of this.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
# Infra-level (env only — not exposed in the admin panel):
AI_EMBED_DIM=1024
AI_TOP_K=6

# Uploads (admin assets like the landing OG image)
UPLOADS_DIR=./uploads
# Absolute base for building upload URLs (empty = derive from request host)
PUBLIC_BASE_URL=

# FCM push notifications (trial reminders etc.). Point to a Firebase service
# account JSON (Project settings -> Service accounts -> Generate new private key).
FCM_CREDENTIALS_FILE=
# or inline the JSON instead of a file path:
# FCM_CREDENTIALS_JSON=
